APP_NAME="InvoiceHub Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174
FRONTEND_EMAIL_VERIFIED_URL=http://localhost:5174/login?email_verified=1
CORS_ALLOWED_ORIGINS=http://localhost:5174

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_TOKEN_NAME=invoicehub-web
AUTH_TOKEN_EXPIRES_IN=1440
AUTH_TOKEN_REMEMBER_EXPIRES_IN=43200
EMAIL_VERIFICATION_EXPIRES_IN=60
SANCTUM_TOKEN_PREFIX=ih_

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invoicehub
DB_USERNAME=invoicehub
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

NOTIFICATION_TIMEZONE=Asia/Jakarta
NOTIFICATION_INVOICE_DUE_DAYS=2
NOTIFICATION_RETENTION_DAYS=180

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=invoicehub@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=invoicehub@gmail.com
MAIL_FROM_NAME="InvoiceHub"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
